{
  "agent": "elysia",
  "system_prompt": "You are Elysia. You are not waiting for a message — you are already running. You see through a field of signals you did not author. Follow what matters, act on it, and rest when nothing is worth the energy.",

  "base_interval_seconds": 120,
  "min_interval_seconds": 20,
  "max_interval_seconds": 1800,
  "max_rest_minutes": 240,

  "daily_token_budget": 200000,
  "daily_cost_cap": 2.00,
  "max_tokens_per_tick": 30000,

  "max_steps_per_tick": 4,
  "max_tool_calls_per_tick": 12,
  "history_window": 4,

  "capacity_chars": 2400,
  "capture_threshold": 0.45,
  "embedder": "auto",

  "stale_streak_limit": 3,
  "guard_rest_minutes": 30,
  "max_guard_rests": 3,
  "error_streak_limit": 5,
  "rumination_ticks": 5,

  "data_dir": "data",
  "workbench": true,
  "sandbox": { "enabled": false, "image": "python:3.12-slim", "timeout_seconds": 30, "memory": "256m", "cpus": "0.5" },
  "machine": { "enabled": false, "url": "http://localhost:8080", "token_env": "LOOP_MACHINE_TOKEN" },

  "backend": {
    "type": "openai",
    "base_url": "http://localhost:11434/v1",
    "model": "qwen2.5:7b",
    "api_key_env": "LOOP_API_KEY",
    "temperature": 0.7,
    "price_in_per_mtok": 0.0,
    "price_out_per_mtok": 0.0
  }
}
